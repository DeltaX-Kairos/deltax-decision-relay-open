[Unit]
Description=Decision Relay Service (Buyer and Supplier Paired Loopback)
Documentation=https://relay.deltaxevaluate.com
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=decision-relay
Group=decision-relay
WorkingDirectory=/opt/decision-relay
ExecStart=/usr/bin/node /opt/decision-relay/src/live-server.js
Restart=on-failure
RestartSec=5
TimeoutStartSec=30
TimeoutStopSec=15

# Private environment file (install root:root chmod 0600)
EnvironmentFile=/etc/decision-relay/relay.env

# Dedicated state directory (/var/lib/decision-relay) for ledgers and cutoffs
StateDirectory=decision-relay
StateDirectoryMode=0700
UMask=0077

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=decision-relay

# Strict non-root and filesystem hardening (0600 data under StateDirectory)
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ReadOnlyPaths=/opt/decision-relay
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
ProtectProc=invisible
ProcSubset=pid
RestrictSUIDSGID=true
RemoveIPC=true
LockPersonality=true
CapabilityBoundingSet=
AmbientCapabilities=
RestrictNamespaces=true
RestrictRealtime=true

# Network family restriction: allow IPv4/IPv6 (plus AF_UNIX for Node/libuv internal IPC)
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

# V8 JIT requires W+X mappings unless --jitless is used
MemoryDenyWriteExecute=false
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources @obsolete @mount @debug @cpu-emulation @reboot @swap @raw-io

[Install]
WantedBy=multi-user.target
