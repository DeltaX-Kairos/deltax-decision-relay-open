# Decision Relay environment template
# Install to /etc/decision-relay/relay.env with permissions 0600 (root:root)
# Runtime ledger and cutoff data are stored under /var/lib/decision-relay (0700 dir, 0600 files)
# Do NOT commit real secrets or assume any paid provider budget.

# Loopback-only service binding (no direct external network exposure)
NODE_ENV=production
BUYER_PORT=19170
SUPPLIER_PORT=19171

# Canonical public origins served via Caddy (for loopback-only testing use http://127.0.0.1:19170 and http://localhost:19171)
BUYER_ORIGIN=https://relay.deltaxevaluate.com
SUPPLIER_ORIGIN=https://relay-supplier.deltaxevaluate.com

# Hosted execution disabled by default (0 = offline replay only)
RELAY_HOSTED_MODE=0

# Runtime cryptographic keys: 64 hex characters (32 bytes).
# Generate on target host at install time, e.g.: openssl rand -hex 32
RELAY_EVIDENCE_KEY=
RELAY_RECEIPT_KEY=

# Evaluate provider credentials and ledger (leave credentials empty; no paid budget assumed)
RELAY_EVALUATE_CLIENT_ID=
RELAY_EVALUATE_CLIENT_SECRET=
RELAY_EVALUATE_LEDGER_FILE=/var/lib/decision-relay/evaluate-ledger.jsonl

# Hosted budget & window limits (default 0 = no paid budget assumed)
RELAY_HOSTED_BUDGET=0
RELAY_HOSTED_WINDOW_LIMIT=0

# UTC cutoff timestamp (2027-01-18 17:00 PST / UTC-8)
RELAY_CUTOFF=2027-01-19T01:00:00Z

# Optional Otari provider configuration (leave empty/0 unless explicitly enabled)
RELAY_OTARI_API_KEY=
RELAY_OTARI_MODEL=
RELAY_OTARI_LEDGER_FILE=/var/lib/decision-relay/otari-ledger.jsonl
RELAY_OTARI_BUDGET=0
RELAY_OTARI_WINDOW_LIMIT=0
